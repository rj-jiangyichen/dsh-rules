{
  "name": "dsh-rules",
  "version": "0.1.5",
  "description": "DSH rules plugin: activate rule prompts / markdown documents by glob-matching the files an agent reads or edits (Claude Code rules.md style).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rules",
    "claude-code",
    "agents",
    "prompt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rj-jiangyichen/dsh-rules.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./rules": "./lib/rules.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "picomatch": "^4.0.2",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "picomatch": "^4.0.2",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "pnpm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
